+/*
+ * pango_extents_to_logical_pixels:
+ * @inclusive: (nullable): rectangle to convert using expand rounding,
+ *   or %NULL
+ * @nearest: (nullable): rectangle to convert using nearest rounding,
+ *   or %NULL
+ * @scale: the resource scale of the actor
+ *
+ * Like pango_extents_to_pixels(), but divides by @scale first to
+ * produce logical pixel values.  The @inclusive rectangle floors the
+ * origin and ceils the far edges so the result always fully contains
+ * the input; @nearest rounds each edge to the nearest pixel.
+ *
+ * This must be used instead of pango_to_logical_pixels() when
+ * converting rectangles whose origin can be negative (e.g. ink
+ * extents), because pango_to_logical_pixels() uses ceilf() which
+ * rounds negative origins toward zero, shrinking the covered area.
+ */
+static void
+pango_extents_to_logical_pixels (PangoRectangle *inclusive,
+                                 PangoRectangle *nearest,
+                                 float           scale)
+{
+  if (inclusive)
+    {
+      float orig_x = (float) inclusive->x / scale;
+      float orig_y = (float) inclusive->y / scale;
+      float end_x = (float) (inclusive->x + inclusive->width) / scale;
+      float end_y = (float) (inclusive->y + inclusive->height) / scale;
+
+      inclusive->x = (int) floorf (orig_x / (float) PANGO_SCALE);
+      inclusive->y = (int) floorf (orig_y / (float) PANGO_SCALE);
+      inclusive->width = (int) ceilf (end_x / (float) PANGO_SCALE) - inclusive->x;
+      inclusive->height = (int) ceilf (end_y / (float) PANGO_SCALE) - inclusive->y;
+    }
+
+  if (nearest)
+    {
+      float orig_x = (float) nearest->x / scale;
+      float orig_y = (float) nearest->y / scale;
+      float end_x = (float) (nearest->x + nearest->width) / scale;
+      float end_y = (float) (nearest->y + nearest->height) / scale;
+
+      nearest->x = (int) roundf (orig_x / (float) PANGO_SCALE);
+      nearest->y = (int) roundf (orig_y / (float) PANGO_SCALE);
+      nearest->width = (int) roundf (end_x / (float) PANGO_SCALE) - nearest->x;
+      nearest->height = (int) roundf (end_y / (float) PANGO_SCALE) - nearest->y;
+    }
+}
