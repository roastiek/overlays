+         * break on GNOME Shell updates. Retries via idle_add until it exists.
+         */
+        _findPowerIcon() {
+            this._powerIconIdleId = GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+                const topBarIcon = Main.panel.statusArea.quickSettings?._system?._indicator;
+                if (!topBarIcon) {
+                    return GLib.SOURCE_CONTINUE;
+                }
+                this._powerIconIdleId = null;
+                this._powerTopBarIcon = topBarIcon;
+                this._powerTopBarIconOriginalStyle = topBarIcon.style;
