@@ -20,18 +20,71 @@ export default class Preferences extends ExtensionPreferences {
 
         const builder = Gtk.Builder.new_from_file(`${this.metadata.path}/data/ui/preferences.ui`);
 
-        this.getSettings().bind(
+        const settings = this.getSettings();
+
+        settings.bind(
             'show-indicator',
