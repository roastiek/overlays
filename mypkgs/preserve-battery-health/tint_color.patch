         window.add(builder.get_object('general'));
 
         window.search_enabled = true;
     }
 
+    /**
+     * Bind a colour picker to a colour setting (stored as a hex string,
+     * empty meaning "use the system default colour"), converting to/from
+     * Gdk.RGBA. Also wires the reset button to clear the setting back to
+     * its default (empty/system colour).
+     *
+     * @param {Gio.Settings} settings The extension's settings
+     * @param {string} key The settings key to bind (a string/hex colour)
+     * @param {Gtk.ColorDialogButton} colorButton The colour picker button
+     * @param {Gtk.Button} resetButton The reset-to-default button
+     */
+    _bindIndicatorColor(settings, key, colorButton, resetButton) {
+        const FALLBACK_DISPLAY_COLOR = '#ffffff';
+
+        const hexToRgba = (hex) => {
+            const rgba = new Gdk.RGBA();
+            rgba.parse(hex || FALLBACK_DISPLAY_COLOR);
+            return rgba;
+        };
+
+        const rgbaToHex = (rgba) => {
+            const toHex = (value) => Math.round(value * 255).toString(16).padStart(2, '0');
+            return `#${toHex(rgba.red)}${toHex(rgba.green)}${toHex(rgba.blue)}`;
+        };
+
+        colorButton.set_rgba(hexToRgba(settings.get_string(key)));
+
+        colorButton.connect('notify::rgba', () => {
+            settings.set_string(key, rgbaToHex(colorButton.get_rgba()));
+        });
+
+        resetButton.connect('clicked', () => {
+            settings.reset(key);
+        });
+
+        settings.connect(`changed::${key}`, () => {
+            colorButton.set_rgba(hexToRgba(settings.get_string(key)));
+        });
+    }
