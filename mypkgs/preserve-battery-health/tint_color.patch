             'active',
             Gio.SettingsBindFlags.DEFAULT
         );
 
+        this._bindIndicatorColor(
+            settings, 'indicator-color-active',
+            builder.get_object('indicator_color_active'),
+            builder.get_object('indicator_color_active_reset')
+        );
+        this._bindIndicatorColor(
